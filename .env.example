# ── CMA Python Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.

# Probe42 API key (for corporate-registry lookups)
# Get yours at https://api.probe42.in
# PROBE42_API_KEY=your_api_key_here

# Optional overrides:
# PROBE42_BASE=https://api.probe42.in/probe_pro
# PROBE42_VERSION=1.3

# Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# API server settings
# API_HOST=127.0.0.1
# API_PORT=8000

# Tesseract OCR path (default auto-detected on most systems)
# On Windows, typically: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=tesseract
